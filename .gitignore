# The vendored original keeps its upstream history locally, but we do not nest a repo.
GliderPRO/upstream.git/

# Rootless toolchain: Go lives in ~/.local/opt/go, C libs are unpacked here on demand.
.toolchain/

# Generated by scripts/bootstrap-dev-env.sh (machine-specific paths).
scripts/env.sh

# Build output
/bin/
/dist/
*.test
*.out

# Extracted assets are reproducible from GliderPRO/ via tools/ -- do not commit them.
/assets/extracted/
